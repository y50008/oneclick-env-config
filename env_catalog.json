{
  "app_name": "一键环境配置",
  "version": "0.1.0",
  "description": "面向开发者、游戏开发与游戏玩家的一键环境安装工具：检测 → 选择 → 安装 → 配置 → 验证 → 切换 / 卸载",
  "catalog_note": "自动安装通道：winget（主流软件）/ zip（托管式多版本）/ exe / msi；其余为引导型（打开官方下载页，避免配置不可控）。",
  "environments": [
    {"id": "jdk", "name": "JDK（Temurin）", "category": "A 语言运行时", "desc": "Java 开发与运行，多版本共存切换", "note": "多版本托管安装，切换 JAVA_HOME 与 PATH 生效", "detect": {"mode": "cmd", "cmd": ["java", "-version"], "regex": "version \"([^\"]+)\""}, "install": {"type": "zip", "managed": true, "switchable": true, "versions": ["8", "11", "17", "21", "25"], "url_template": "https://api.adoptium.net/v3/binary/latest/{version}/ga/windows/x64/jdk/hotspot/normal/eclipse", "env_var_set": {"JAVA_HOME": "{dir}"}, "env": {"PATH_APPEND": "bin"}, "smoke": ["java", "-version"]}, "uninstall": {"type": "managed"}},
    {"id": "python", "name": "Python", "category": "A 语言运行时", "desc": "脚本、数据分析、AI；多版本由 py 启动器管理", "detect": {"mode": "cmd", "cmd": ["py", "--version"], "regex": "Python (\\S+)"}, "install": {"type": "winget", "winget_id": "Python.Python.3.13", "smoke": ["py", "--version"]}, "uninstall": {"type": "winget"}},
    {"id": "nodejs", "name": "Node.js", "category": "A 语言运行时", "desc": "前端与 Node 后端，多版本共存切换", "detect": {"mode": "cmd", "cmd": ["node", "--version"], "regex": "v(\\S+)"}, "install": {"type": "zip", "managed": true, "switchable": true, "versions": ["16", "18", "20", "22", "24"], "node_major": true, "env": {"PATH_APPEND": "."}, "smoke": ["node", "--version"]}, "uninstall": {"type": "managed"}},
    {"id": "go", "name": "Go", "category": "A 语言运行时", "desc": "后端服务、CLI 工具", "detect": {"mode": "cmd", "cmd": ["go", "version"], "regex": "go version go(\\S+)"}, "install": {"type": "winget", "winget_id": "GoLang.Go", "smoke": ["go", "version"]}, "uninstall": {"type": "winget"}},
    {"id": "rust", "name": "Rust", "category": "A 语言运行时", "desc": "系统级开发（rustup）", "detect": {"mode": "cmd", "cmd": ["rustc", "--version"], "regex": "rustc (\\S+)"}, "install": {"type": "winget", "winget_id": "Rustlang.Rustup", "smoke": ["rustc", "--version"]}, "uninstall": {"type": "winget"}},
    {"id": "mingw", "name": "MinGW-w64", "category": "A 语言运行时", "desc": "C/C++ 编译（GCC）", "detect": {"mode": "cmd", "cmd": ["gcc", "--version"], "regex": "gcc \\((?:\\S+)\\) (\\S+)"}, "install": {"type": "guide", "page": "https://www.mingw-w64.org/downloads/"}, "uninstall": {"type": "guide"}},
    {"id": "msvc", "name": "MSVC Build Tools", "category": "A 语言运行时", "desc": "C/C++ 编译（MSVC）、node-gyp", "detect": {"mode": "registry", "pattern": "Visual Studio Build Tools"}, "install": {"type": "guide", "page": "https://visualstudio.microsoft.com/downloads/#build-tools-for-visual-studio-2022"}, "uninstall": {"type": "guide"}},
    {"id": "dotnet-sdk", "name": ".NET SDK", "category": "A 语言运行时", "desc": "C#、.NET 开发", "detect": {"mode": "cmd", "cmd": ["dotnet", "--version"], "regex": "(\\S+)"}, "install": {"type": "winget", "winget_id": "Microsoft.DotNet.SDK.8", "smoke": ["dotnet", "--version"]}, "uninstall": {"type": "winget"}},
    {"id": "php", "name": "PHP", "category": "A 语言运行时", "desc": "Web 开发", "detect": {"mode": "cmd", "cmd": ["php", "--version"], "regex": "PHP (\\S+)"}, "install": {"type": "guide", "page": "https://windows.php.net/download/"}, "uninstall": {"type": "guide"}},
    {"id": "ruby", "name": "Ruby", "category": "A 语言运行时", "desc": "脚本、Ruby on Rails", "detect": {"mode": "cmd", "cmd": ["ruby", "--version"], "regex": "ruby (\\S+)"}, "install": {"type": "winget", "winget_id": "RubyInstallerTeam.Ruby.3.3", "smoke": ["ruby", "--version"]}, "uninstall": {"type": "winget"}},

    {"id": "mysql", "name": "MySQL", "category": "B 数据库", "desc": "关系型数据库", "note": "安装向导需自行设置 root 密码", "detect": {"mode": "cmd", "cmd": ["mysql", "--version"], "regex": "(\\S+)"}, "install": {"type": "guide", "page": "https://dev.mysql.com/downloads/installer/"}, "uninstall": {"type": "guide"}},
    {"id": "postgresql", "name": "PostgreSQL", "category": "B 数据库", "desc": "关系型数据库", "note": "安装向导需设置 superuser 密码", "detect": {"mode": "cmd", "cmd": ["psql", "--version"], "regex": "psql \\(PostgreSQL\\) (\\S+)"}, "install": {"type": "guide", "page": "https://www.postgresql.org/download/windows/"}, "uninstall": {"type": "guide"}},
    {"id": "sqlserver", "name": "SQL Server", "category": "B 数据库", "desc": "企业关系型数据库（Express / Developer）", "detect": {"mode": "registry", "pattern": "Microsoft SQL Server"}, "install": {"type": "guide", "page": "https://www.microsoft.com/sql-server/sql-server-downloads"}, "uninstall": {"type": "guide"}},
    {"id": "mongodb", "name": "MongoDB", "category": "B 数据库", "desc": "文档型数据库", "detect": {"mode": "cmd", "cmd": ["mongod", "--version"], "regex": "db version v(\\S+)"}, "install": {"type": "winget", "winget_id": "MongoDB.Server", "smoke": ["mongod", "--version"]}, "uninstall": {"type": "winget"}},
    {"id": "sqlite", "name": "SQLite", "category": "B 数据库", "desc": "嵌入式数据库", "note": "多数应用已内置，一般无需单独安装", "detect": {"mode": "cmd", "cmd": ["sqlite3", "--version"], "regex": "(\\S+)"}, "install": {"type": "guide", "page": "https://www.sqlite.org/download.html"}, "uninstall": {"type": "guide"}},
    {"id": "mariadb", "name": "MariaDB", "category": "B 数据库", "desc": "MySQL 兼容分支", "detect": {"mode": "cmd", "cmd": ["mariadb", "--version"], "regex": "(\\S+)"}, "install": {"type": "guide", "page": "https://mariadb.org/download/"}, "uninstall": {"type": "guide"}},
    {"id": "oracle-xe", "name": "Oracle XE", "category": "B 数据库", "desc": "企业数据库场景", "detect": {"mode": "registry", "pattern": "Oracle Database"}, "install": {"type": "guide", "page": "https://www.oracle.com/database/technologies/xe-downloads.html"}, "uninstall": {"type": "guide"}},

    {"id": "redis", "name": "Redis", "category": "C 中间件与 Web 服务器", "desc": "缓存、队列（Windows 移植版）", "detect": {"mode": "cmd", "cmd": ["redis-server", "--version"], "regex": "v=(\\S+)"}, "install": {"type": "zip", "managed": true, "versions": ["5.0.14.1"], "url_template": "https://github.com/tporadowski/redis/releases/download/v{version}/Redis-x64-{version}.zip", "env": {"PATH_APPEND": "."}, "smoke": ["redis-server", "--version"]}, "uninstall": {"type": "managed"}},
    {"id": "rabbitmq", "name": "RabbitMQ", "category": "C 中间件与 Web 服务器", "desc": "消息队列", "note": "需先安装 Erlang", "detect": {"mode": "registry", "pattern": "RabbitMQ"}, "install": {"type": "guide", "page": "https://www.rabbitmq.com/install-windows.html"}, "uninstall": {"type": "guide"}},
    {"id": "kafka", "name": "Kafka", "category": "C 中间件与 Web 服务器", "desc": "流处理、消息总线", "note": "需 JDK；建议使用 KRaft 单机模式", "detect": {"mode": "guide"}, "install": {"type": "guide", "page": "https://kafka.apache.org/downloads"}, "uninstall": {"type": "guide"}},
    {"id": "elasticsearch", "name": "Elasticsearch", "category": "C 中间件与 Web 服务器", "desc": "搜索、日志分析", "note": "需 JDK", "detect": {"mode": "registry", "pattern": "Elasticsearch"}, "install": {"type": "guide", "page": "https://www.elastic.co/cn/downloads/elasticsearch"}, "uninstall": {"type": "guide"}},
    {"id": "nginx", "name": "Nginx", "category": "C 中间件与 Web 服务器", "desc": "反向代理、静态站点", "detect": {"mode": "managed"}, "install": {"type": "zip", "managed": true, "versions": ["1.26.2"], "url_template": "https://nginx.org/download/nginx-{version}.zip", "env": {"PATH_APPEND": "."}, "smoke": ["nginx", "-v"]}, "uninstall": {"type": "managed"}},
    {"id": "apache", "name": "Apache HTTP Server", "category": "C 中间件与 Web 服务器", "desc": "Web 服务器", "detect": {"mode": "cmd", "cmd": ["httpd", "-v"], "regex": "Apache/(\\S+)"}, "install": {"type": "guide", "page": "https://httpd.apache.org/download.cgi"}, "uninstall": {"type": "guide"}},
    {"id": "tomcat", "name": "Tomcat", "category": "C 中间件与 Web 服务器", "desc": "Java Web 容器", "note": "需 JDK；自动设置 CATALINA_HOME", "detect": {"mode": "managed"}, "install": {"type": "zip", "managed": true, "versions": ["10.1.34"], "url_template": "https://archive.apache.org/dist/tomcat/tomcat-10/v{version}/bin/apache-tomcat-{version}-windows-x64.zip", "env_var_set": {"CATALINA_HOME": "{dir}"}, "env": {"PATH_APPEND": "bin"}, "smoke": []}, "uninstall": {"type": "managed"}},
    {"id": "zookeeper", "name": "ZooKeeper", "category": "C 中间件与 Web 服务器", "desc": "分布式协调（旧生态）", "note": "需 JDK", "detect": {"mode": "guide"}, "install": {"type": "guide", "page": "https://zookeeper.apache.org/releases.html"}, "uninstall": {"type": "guide"}},

    {"id": "maven", "name": "Maven", "category": "D 构建与包管理", "desc": "Java 构建与依赖管理", "note": "需 JDK", "detect": {"mode": "cmd", "cmd": ["mvn", "--version"], "regex": "Apache Maven (\\S+)"}, "install": {"type": "zip", "managed": true, "versions": ["3.9.9"], "url_template": "https://archive.apache.org/dist/maven/maven-3/{version}/binaries/apache-maven-{version}-bin.zip", "env": {"PATH_APPEND": "bin"}, "smoke": ["mvn", "--version"]}, "uninstall": {"type": "managed"}},
    {"id": "gradle", "name": "Gradle", "category": "D 构建与包管理", "desc": "Java / Android 构建", "note": "需 JDK", "detect": {"mode": "cmd", "cmd": ["gradle", "--version"], "regex": "Gradle (\\S+)"}, "install": {"type": "guide", "page": "https://gradle.org/releases/"}, "uninstall": {"type": "guide"}},
    {"id": "yarn", "name": "yarn / pnpm", "category": "D 构建与包管理", "desc": "JavaScript 包管理（npm 随 Node）", "detect": {"mode": "cmd", "cmd": ["yarn", "--version"], "regex": "(\\S+)"}, "install": {"type": "guide", "page": "https://pnpm.io/zh/installation"}, "uninstall": {"type": "guide"}},
    {"id": "poetry", "name": "pip / poetry / uv", "category": "D 构建与包管理", "desc": "Python 包管理（随 Python）", "detect": {"mode": "cmd", "cmd": ["uv", "--version"], "regex": "uv (\\S+)"}, "install": {"type": "guide", "page": "https://docs.astral.sh/uv/"}, "uninstall": {"type": "guide"}},
    {"id": "miniconda", "name": "Miniconda", "category": "D 构建与包管理", "desc": "Python 数据科学环境", "detect": {"mode": "cmd", "cmd": ["conda", "--version"], "regex": "conda (\\S+)"}, "install": {"type": "winget", "winget_id": "Anaconda.Miniconda3", "smoke": ["conda", "--version"]}, "uninstall": {"type": "winget"}},
    {"id": "cmake", "name": "CMake", "category": "D 构建与包管理", "desc": "C/C++ 构建", "detect": {"mode": "cmd", "cmd": ["cmake", "--version"], "regex": "cmake version (\\S+)"}, "install": {"type": "winget", "winget_id": "Kitware.CMake", "smoke": ["cmake", "--version"]}, "uninstall": {"type": "winget"}},
    {"id": "gnumake", "name": "GNU Make", "category": "D 构建与包管理", "desc": "构建脚本", "detect": {"mode": "cmd", "cmd": ["make", "--version"], "regex": "(\\S+)"}, "install": {"type": "guide", "page": "https://gnuwin32.sourceforge.net/packages/make.htm"}, "uninstall": {"type": "guide"}},
    {"id": "ant", "name": "Apache Ant", "category": "D 构建与包管理", "desc": "传统 Java 构建", "note": "需 JDK", "detect": {"mode": "cmd", "cmd": ["ant", "-version"], "regex": "Apache Ant\\(TM\\) version (\\S+)"}, "install": {"type": "guide", "page": "https://ant.apache.org/bindownload.cgi"}, "uninstall": {"type": "guide"}},
    {"id": "protoc", "name": "protoc", "category": "D 构建与包管理", "desc": "Protobuf 编译", "detect": {"mode": "cmd", "cmd": ["protoc", "--version"], "regex": "(\\S+)"}, "install": {"type": "guide", "page": "https://github.com/protocolbuffers/protobuf/releases"}, "uninstall": {"type": "guide"}},

    {"id": "git", "name": "Git", "category": "E 版本控制", "desc": "代码版本管理（含 Git LFS）", "detect": {"mode": "cmd", "cmd": ["git", "--version"], "regex": "git version (\\S+)"}, "install": {"type": "winget", "winget_id": "Git.Git", "smoke": ["git", "--version"]}, "uninstall": {"type": "winget"}},
    {"id": "svn", "name": "SVN", "category": "E 版本控制", "desc": "遗留项目版本管理", "detect": {"mode": "cmd", "cmd": ["svn", "--version"], "regex": "svn, version (\\S+)"}, "install": {"type": "guide", "page": "https://sliksvn.com/download/"}, "uninstall": {"type": "guide"}},

